<Window
    x:Class="CS2AccountHub.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <NavigationView x:Name="Nav" IsSettingsVisible="True" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Play Ready" Tag="PlayReady">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Accept" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Not Play Ready" Tag="NotPlayReady">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Important" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Loadout" Tag="Loadout">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Personalize" Tag="Personalize">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,18">
                    <TextBlock x:Name="PageTitle" Text="Play Ready" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Add account" Click="AddAccount_Click" />
                    <ComboBox x:Name="PrimeFilter" Width="150" SelectedIndex="0" SelectionChanged="PrimeFilter_SelectionChanged">
                        <ComboBoxItem Content="Prime" Tag="Prime" />
                        <ComboBoxItem Content="Non-Prime" Tag="NonPrime" />
                        <ComboBoxItem Content="Unknown" Tag="Unknown" />
                    </ComboBox>
                    <Button Content="Refresh" Click="Refresh_Click" />
                </StackPanel>

                <Grid x:Name="AccountsView" Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListView x:Name="AccountsList" SelectionChanged="AccountsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PersonaName}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SteamId}" Opacity="0.65" />
                                            <TextBlock Text="{Binding CooldownSeconds}" Opacity="0.75" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Refresh Status" Tag="{Binding Id}" Click="RefreshAccount_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer Grid.Column="1">
                        <StackPanel x:Name="DetailsPanel" Spacing="12">
                            <TextBlock Text="Account details" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailsName" FontSize="18" />
                            <TextBlock x:Name="DetailsStatus" TextWrapping="Wrap" />
                            <TextBox x:Name="NoteBox" PlaceholderText="Add a note..." />
                            <Button Content="Save note" Click="SaveNote_Click" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Clear Workshop" Click="ClearWorkshop_Click" />
                                <Button Content="Apply Loadout" Click="ApplyLoadout_Click" />
                                <Button Content="Personalize" Click="Personalize_Click" />
                            </StackPanel>
                            <Button Content="Sign-In" Click="SignIn_Click" />
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer x:Name="LoadoutView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="1080">
                        <TextBlock Text="Loadout" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Configure the CS2 loadout once. It is saved on the server and applied remotely to the selected account." TextWrapping="Wrap" Opacity="0.75" />
                        <RadioButtons x:Name="LoadoutTeamSelector" SelectionChanged="LoadoutTeamSelector_SelectionChanged">
                            <RadioButton Content="Terrorist" IsChecked="True" />
                            <RadioButton Content="Counter-Terrorist" />
                        </RadioButtons>
                        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="20">
                            <Grid x:Name="LoadoutEditorHost" ColumnSpacing="18" />
                        </Border>
                        <Button Content="Save loadout preset" Click="SaveLoadout_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PersonalizeView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="1080">
                        <TextBlock Text="Personalize" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Edit the profile preset locally, then send the complete change to the backend with one click." TextWrapping="Wrap" Opacity="0.75" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="18">
                                <StackPanel Spacing="12" Width="300">
                                    <TextBlock Text="Avatar" FontSize="17" FontWeight="SemiBold" />
                                    <Border Width="220" Height="220" CornerRadius="8" HorizontalAlignment="Center" Background="{ThemeResource PageBackgroundBrush}">
                                        <Image x:Name="AvatarPreview" Stretch="UniformToFill" />
                                    </Border>
                                    <Button Content="Choose image" Click="PickAvatar_Click" />
                                    <TextBlock x:Name="AvatarStatus" Text="No image selected" TextWrapping="Wrap" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="18">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="PersonaNameBox" Header="Nickname" MaxLength="64" />
                                    <TextBox x:Name="RealNameBox" Grid.Row="1" Header="Real name" MaxLength="64" />
                                    <TextBox x:Name="SummaryBox" Grid.Row="2" Header="Summary" AcceptsReturn="True" MinHeight="160" TextWrapping="Wrap" />
                                    <CheckBox x:Name="ClearAliasBox" Grid.Row="3" Content="Clear alias history" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Button Content="Save personalization preset" Click="SavePersonalize_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
